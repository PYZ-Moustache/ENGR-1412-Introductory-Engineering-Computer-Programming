# Star Exercise: Design a formula and a program which uses the GCD to calculate the sum of two fractions


def inputFraction():
    while True:
        frac = input("Enter a fraction in the form x/y:")
        if "/" not in frac:
            print("Invalid input. Please enter in the form x/y:")
            continue
        nume, deno = frac.split("/")
        try:
            nume = int(nume)
            deno = int(deno)
            if deno == 0:
                print("Denominator cannot be zero. Please enter again.")
                continue
            return nume, deno
        except:
            print("Invalid input. Please enter in the form x/y")
            continue

nume1, deno1 = inputFraction()
nume2, deno2 = inputFraction()
# calculate the result nume/deno
nume = nume1 * deno2 + nume2 * deno1
deno = deno1 * deno2
# find the GCD of nume and deno
num1 = abs(nume)
num2 = abs(deno)
if num2 > num1:
    num1, num2 = num2, num1 # make num1 > num2
n = 1
while n <= num2:
    if num1 % n == 0 and num2 % n == 0:
        gcd = n
    n += 1
# simplify the result
nume = int(nume / gcd)
deno = int(deno / gcd)
if abs(nume) != deno:
    print(f"The sum of {nume1}/{deno1} and {nume2}/{deno2} is {nume}/{deno}")
else:
    if nume > 0:
        print(f"The sum of {nume1}/{deno1} and {nume2}/{deno2} is 1")
    elif nume < 0:
        print(f"The sum of {nume1}/{deno1} and {nume2}/{deno2} is -1")
