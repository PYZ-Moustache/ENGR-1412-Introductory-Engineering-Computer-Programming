/*
Write a Program Cell for the Factorial
*/


n = int(input("Enter a number: "))

if n < 0:
    print("Sorry, factorial does not exist for negative numbers")
elif n == 0:
    print("The factorial of 0 is 1")
else:
    factorial = 1
    number = n
    while n > 1:
        factorial *= n
        n -= 1
    print("The factorial of", number, "is", factorial)
