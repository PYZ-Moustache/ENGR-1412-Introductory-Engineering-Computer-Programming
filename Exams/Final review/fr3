# 题目要求：编写一个快速排序（qsort）函数，并计算函数调用的次数。
# 题目描述： 快速排序是一种常见的排序算法，通过递归地将数组分割成较小和较大的子数组，然后对子数组进行排序，最终实现整个数组的排序。
# 请编写一个名为 qsort 的函数，用于对给定的列表进行快速排序。同时，使用一个全局变量 j 来记录函数调用的次数，即每次进入 qsort 函数时 j 的值加 1。
# 函数 qsort 的输入参数为一个列表 lst，函数的输出为排序后的列表。
# 请完成上述要求并编写对应的 Python 代码。


j = 0

def partition(lst, k):
    smaller, equal, larger = [], [], []
    for i in range(len(lst)):
        if lst[i] > k:
            larger.append(lst[i])
        elif lst[i] == k:
            equal.append(lst[i])
        else:
            smaller.append(lst[i])
    return smaller, equal, larger

def qsort(lst):
    global j
    j += 1
    if len(lst) <= 1:
        return lst
    else:
        smaller, equal, larger = partition(lst, lst[0])
        smaller = qsort(smaller)
        larger = qsort(larger)
    sorted_lst = smaller + equal + larger
    return sorted_lst

import random
lst = [random.randrange(1, 100) for i in range(10)]

print("Random list:", lst)
sorted_lst = qsort(lst)
print("Sorted list:", sorted_lst)
print("The number of function calls:", j)
