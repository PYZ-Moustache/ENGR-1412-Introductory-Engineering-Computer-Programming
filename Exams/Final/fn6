# 6-1
class classLecturer:
    def __init__(self, familyName, position, university, faculty, hometown, age):
        self.familyName = familyName
        self.position = position
        self.university = university
        self.faculty = faculty
        self.hometown = hometown
        self.age = age
    
    def display(self):
        print(self.familyName, self.position, self.university, self.faculty, self.hometown, self.age)

aaa = classLecturer('Pluemer', 'Full Professor', 'Southwest Jiaotong University', 'Faculty of Geoscience and Environmental Engineering', 'Germany', '50')
aaa.display()

